{
  "rules": {
    "admin_users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admin_users').child(auth.uid).val() == true)",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admin_users').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admin_users').child(auth.uid).val() == true)"
      }
    },
    "quick_categories": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin_users').child(auth.uid).val() == true"
    },
    "quiz_results": {
      "$resultId": {
        ".read": "auth != null && root.child('admin_users').child(auth.uid).val() == true",
        ".write": "auth != null && (root.child('admin_users').child(auth.uid).val() == true || (!data.exists() && newData.child('userId').val() == auth.uid))",
        ".validate": "newData.hasChildren(['attemptId', 'userId', 'category', 'totalQuestions', 'correctAnswers', 'wrongAnswers', 'score', 'percentage', 'timestamp']) && (root.child('admin_users').child(auth.uid).val() == true || newData.child('userId').val() == auth.uid) && newData.child('totalQuestions').isNumber() && newData.child('correctAnswers').isNumber() && newData.child('wrongAnswers').isNumber() && newData.child('percentage').isNumber()"
      }
    },
    "tournament_attempts": {
      "$attemptId": {
        ".read": "auth != null && root.child('admin_users').child(auth.uid).val() == true",
        ".write": "auth != null && (root.child('admin_users').child(auth.uid).val() == true || (!data.exists() && newData.child('userId').val() == auth.uid))",
        ".validate": "newData.hasChildren(['attemptId', 'userId', 'tournamentId', 'score', 'correctAnswers', 'wrongAnswers', 'totalQuestions', 'percentage', 'completedAt']) && (root.child('admin_users').child(auth.uid).val() == true || newData.child('userId').val() == auth.uid)"
      }
    },
    "admin_settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin_users').child(auth.uid).val() == true"
    },
    "tournaments": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin_users').child(auth.uid).val() == true",
      "$tournamentId": {
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}