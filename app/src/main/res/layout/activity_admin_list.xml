<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/bg_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/adminListTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold"/><Button android:id="@+id/adminListAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD" android:textColor="@color/gold_text_dark" android:background="@drawable/bg_btn_gold"/></LinearLayout>
    <EditText android:id="@+id/adminListSearch" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Search" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:background="@drawable/bg_input" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/adminRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/adminListBack" android:layout_width="match_parent" android:layout_height="48dp" android:text="BACK TO DASHBOARD" android:textColor="@color/gold" android:background="@drawable/bg_btn_outline_red" android:layout_marginTop="10dp"/>
</LinearLayout>