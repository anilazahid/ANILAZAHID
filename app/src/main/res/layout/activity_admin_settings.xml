:layout_marginTop="16dp"/><Button android:id="@+id/settingBack" android:layout_width="match_parent" android:layout_height="48dp" android:text="BACK" android:textColor="@color/gold" android:background="@drawable/bg_btn_outline_red" android:layout_marginTop="10dp"/></LinearLayout></ScrollView>