<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="14dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/tCupImage" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_trophy" android:layout_marginEnd="14dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tournament" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/tDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entry: 10 | Players: 100" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlayTournament" android:layout_width="wrap_content" android:layout_height="40dp" android:text="JOIN" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:textSize="13sp" android:paddingStart="18dp" android:paddingEnd="18dp"/>
</LinearLayout>
