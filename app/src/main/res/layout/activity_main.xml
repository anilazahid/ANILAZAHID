<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ============ AUTH (Royal Dark) ============ -->
    <LinearLayout android:id="@+id/authView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="visible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="250dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_auth_top">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_crown" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUIZ ARENA" android:textColor="@color/gold" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play • Learn • Win Coins" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_sheet_top" android:padding="24dp" android:layout_marginTop="-32dp" android:elevation="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome Back" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign in to continue your journey" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="28dp"/>

            <EditText android:id="@+id/authUsername" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Username" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:layout_marginBottom="14dp" android:visibility="gone"/>
            <EditText android:id="@+id/authEmail" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Email Address" android:inputType="textEmailAddress" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:layout_marginBottom="14dp"/>
            <EditText android:id="@+id/authPass" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Password" android:inputType="textPassword" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:layout_marginBottom="22dp"/>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAuthSubmit" android:layout_width="match_parent" android:layout_height="54dp" android:text="LOGIN" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:elevation="4dp"/>

            <LinearLayout android:id="@+id/btnGoogleSignIn" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_btn_google" android:gravity="center" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_google"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Continue with Google" android:textColor="#1D133B" android:textStyle="bold" android:textSize="15sp" android:layout_marginStart="10dp"/>
            </LinearLayout>

            <TextView android:id="@+id/btnToggleAuth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New User? Register here" android:textColor="@color/gold" android:textSize="14sp" android:gravity="center" android:layout_marginTop="26dp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ MAIN APP ============ -->
    <RelativeLayout android:id="@+id/mainAppView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        
        <!-- BANNER AD VIEW -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottomNav"
            android:layout_centerHorizontal="true"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        <FrameLayout android:id="@+id/pageContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/adView">

            <!-- HOME -->
            <androidx.core.widget.NestedScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="20dp" android:visibility="visible">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="8dp" android:layout_marginBottom="14dp">
                        <ImageView android:id="@+id/imgUserAvatar" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_user" android:background="@drawable/bg_avatar_ring" android:padding="10dp" android:layout_centerVertical="true"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_toEndOf="@id/imgUserAvatar" android:layout_marginStart="12dp" android:layout_centerVertical="true">
                            <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello, Player 👋" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/>
                            <ProgressBar android:layout_width="140dp" android:layout_height="6dp" android:progress="65" android:progressDrawable="@drawable/progress_gold" android:layout_marginTop="6dp" style="?android:attr/progressBarStyleHorizontal"/>
                        </LinearLayout>
                        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_shield" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <!-- Wallet / Prize Pool Card -->
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/bg_balance_green" android:padding="18dp" android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVAILABLE BALANCE" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                        <LinearLayout android:id="@+id/llCoinVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="26dp">
                            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_coin"/>
                            <TextView android:id="@+id/tvMainCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100" android:textColor="@color/gold" android:textSize="34sp" android:textStyle="bold" android:layout_marginStart="10dp"/>
                        </LinearLayout>
                        <ImageView android:id="@+id/homeTrophy3D" android:layout_width="86dp" android:layout_height="86dp" android:src="@drawable/ic_trophy" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEarnMoreCoins" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_below="@id/llCoinVal" android:layout_marginTop="12dp" android:text="WATCH AD +50" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:textSize="12sp" android:paddingStart="18dp" android:paddingEnd="18dp"/>
                    </RelativeLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAILY REWARD" android:textColor="@color/gold" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/dailyRewardStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claim 20 coins once every day." android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/dailyRewardClaim" android:layout_width="match_parent" android:layout_height="48dp" android:text="CLAIM DAILY REWARD (+20)" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:layout_marginTop="12dp"/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top Categories" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- TOURNAMENTS -->
            <LinearLayout android:id="@+id/pageCategories" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOURNAMENT" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="14dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_tab_container" android:orientation="horizontal" android:gravity="center" android:padding="4dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ONGOING" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/gold_text_dark" android:background="@drawable/bg_tab_active"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="UPCOMING" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="COMPLETED" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerTournamentsFull" android:layout_width="match_parent" android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- LEADERBOARD -->
            <LinearLayout android:id="@+id/pageRank" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEADERBOARD" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="14dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_tab_container" android:orientation="horizontal" android:gravity="center" android:padding="4dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="GLOBAL" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/gold_text_dark" android:background="@drawable/bg_tab_active"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="COUNTRY" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="FRIENDS" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerLeaderboardFull" android:layout_width="match_parent" android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- PROFILE -->
            <LinearLayout android:id="@+id/pageProfile" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginTop="8dp">
                    <ImageView android:id="@+id/imgProfileAvatar" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/ic_user" android:background="@drawable/bg_avatar_ring" android:padding="22dp"/>
                    <TextView android:id="@+id/profName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Player" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
                    <TextView android:id="@+id/profEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="player@email.com" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                    
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEditProfile" android:layout_width="140dp" android:layout_height="36dp" android:text="EDIT PROFILE" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="12dp"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOpenAdmin" android:layout_width="match_parent" android:layout_height="52dp" android:text="ADMIN LOGIN" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:layout_marginTop="12dp"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileLogout" android:layout_width="match_parent" android:layout_height="52dp" android:text="LOGOUT" android:background="@drawable/bg_btn_outline_red" android:textColor="@color/error" android:textStyle="bold" android:layout_marginTop="10dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_topic_pill" android:padding="10dp">
                            <TextView android:id="@+id/profCoins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙 100" android:textColor="@color/gold" android:textStyle="bold" android:textSize="15sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Coins" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_topic_pill" android:padding="10dp" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆 85%" android:textColor="@color/gold" android:textStyle="bold" android:textSize="15sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Win Rate" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_rank_banner" android:padding="16dp" android:layout_marginTop="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your Rank" android:textColor="#3A2400" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#2,345" android:textColor="#2A1B00" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_shield" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="6dp" android:layout_marginTop="14dp">
                    <TextView android:id="@+id/menuAchievements" android:layout_width="match_parent" android:layout_height="50dp" android:text="   🏅  Achievements" android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="15sp" android:drawableEnd="@drawable/ic_chevron" android:paddingEnd="14dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/menuRewards" android:layout_width="match_parent" android:layout_height="50dp" android:text="   🎁  Rewards" android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="15sp" android:drawableEnd="@drawable/ic_chevron" android:paddingEnd="14dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/menuHistory" android:layout_width="match_parent" android:layout_height="50dp" android:text="   🕐  History" android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="15sp" android:drawableEnd="@drawable/ic_chevron" android:paddingEnd="14dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/menuReferEarn" android:layout_width="match_parent" android:layout_height="50dp" android:text="   👥  Refer &amp; Earn" android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="15sp" android:drawableEnd="@drawable/ic_chevron" android:paddingEnd="14dp" android:clickable="true" android:focusable="true"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDailyClaim" android:layout_width="match_parent" android:layout_height="52dp" android:text="CLAIM DAILY BONUS (+20)" android:background="@drawable/bg_btn_gold" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:layout_marginTop="14dp"/>
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="68dp" android:layout_alignParentBottom="true" android:background="@color/surface" app:itemTextColor="@color/bottom_nav_color" app:itemIconTint="@color/bottom_nav_color" app:menu="@menu/bottom_nav_menu" app:labelVisibilityMode="labeled" android:elevation="16dp"/>
    </RelativeLayout>

    <!-- ============ QUIZ (Royal Dark KBC) ============ -->
    <RelativeLayout android:id="@+id/kbcQuizContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_app" android:visibility="gone" android:padding="18dp">
        <RelativeLayout android:id="@+id/quizTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp">
            <ImageButton android:id="@+id/btnCloseQuiz" android:layout_width="42dp" android:layout_height="42dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@drawable/bg_icon_btn" android:tint="@color/text_primary" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:padding="10dp"/>
            <TextView android:id="@+id/quizHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Question 1/10" android:textColor="@color/gold" android:textSize="16sp" android:textStyle="bold" android:layout_centerInParent="true"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_timer_pill" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:gravity="center">
                <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏳ 15s" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout android:id="@+id/quizTopicBanner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/quizTopBar" android:layout_centerHorizontal="true" android:layout_marginBottom="20dp" android:background="@drawable/bg_topic_pill" android:orientation="horizontal" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/quizTopicIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚" android:textSize="20sp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/quizTopicName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/questionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_gold" android:layout_below="@id/quizTopicBanner" android:layout_marginBottom="26dp" android:padding="26dp" android:gravity="center" android:minHeight="170dp">
            <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Question..." android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" android:gravity="center" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView android:id="@+id/quizPointsCurrent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Winning: 0 Coins" android:textColor="@color/gold" android:textSize="14sp" android:textStyle="bold" android:layout_above="@id/llOptions" android:layout_centerHorizontal="true" android:layout_marginBottom="14dp"/>

        <LinearLayout android:id="@+id/llOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_alignParentBottom="true" android:layout_marginBottom="16dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOpt1" android:layout_width="match_parent" android:layout_height="60dp" android:text="A. Opt" android:textColor="@color/text_primary" android:background="@drawable/bg_option_btn" android:layout_marginBottom="12dp" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingStart="22dp" android:textStyle="bold" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOpt2" android:layout_width="match_parent" android:layout_height="60dp" android:text="B. Opt" android:textColor="@color/text_primary" android:background="@drawable/bg_option_btn" android:layout_marginBottom="12dp" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingStart="22dp" android:textStyle="bold" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOpt3" android:layout_width="match_parent" android:layout_height="60dp" android:text="C. Opt" android:textColor="@color/text_primary" android:background="@drawable/bg_option_btn" android:layout_marginBottom="12dp" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingStart="22dp" android:textStyle="bold" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOpt4" android:layout_width="match_parent" android:layout_height="60dp" android:text="D. Opt" android:textColor="@color/text_primary" android:background="@drawable/bg_option_btn" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingStart="22dp" android:textStyle="bold" android:textSize="15sp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
