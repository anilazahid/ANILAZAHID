<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADMIN DASHBOARD" android:textColor="@color/gold" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quiz With Anila Zahid" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="18dp"/>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="true">
            <LinearLayout android:id="@+id/adminUsersCard" style="@style/AdminCard" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USERS" android:textColor="@color/text_secondary"/><TextView android:id="@+id/adminUsersCount" style="@style/AdminCount" android:text="-"/></LinearLayout>
            <LinearLayout android:id="@+id/adminCategoriesCard" style="@style/AdminCard" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIES" android:textColor="@color/text_secondary"/><TextView android:id="@+id/adminCategoriesCount" style="@style/AdminCount" android:text="-"/></LinearLayout>
            <LinearLayout android:id="@+id/adminQuestionsCard" style="@style/AdminCard" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUESTIONS" android:textColor="@color/text_secondary"/><TextView android:id="@+id/adminQuestionsCount" style="@style/AdminCount" android:text="-"/></LinearLayout>
            <LinearLayout android:id="@+id/adminResultsCard" style="@style/AdminCard" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUIZ ATTEMPTS" android:textColor="@color/text_secondary"/><TextView android:id="@+id/adminResultsCount" style="@style/AdminCount" android:text="-"/></LinearLayout>
        </GridLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/adminSettingsCard" android:layout_width="match_parent" android:layout_height="52dp" android:text="APP SETTINGS" android:textColor="@color/gold_text_dark" android:textStyle="bold" android:background="@drawable/bg_btn_gold" android:layout_marginTop="16dp"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/adminLogout" android:layout_width="match_parent" android:layout_height="52dp" android:text="LOGOUT" android:textColor="@color/error" android:textStyle="bold" android:background="@drawable/bg_btn_outline_red" android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>