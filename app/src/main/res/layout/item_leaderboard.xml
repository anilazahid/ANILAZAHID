<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="10dp" android:gravity="center_vertical">
    <TextView android:id="@+id/lbRank" android:layout_width="36dp" android:layout_height="wrap_content" android:text="#1" android:textColor="@color/gold" android:textStyle="bold" android:textSize="16sp"/>
    <TextView android:id="@+id/lbName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Username" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="15sp"/>
    <TextView android:id="@+id/lbScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙 100" android:textColor="@color/gold" android:textStyle="bold" android:textSize="15sp"/>
</LinearLayout>
